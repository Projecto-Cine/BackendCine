# ---------------------------------------------------------------------------
# PLANTILLA para desarrollo local.
#
# Generala con:   .\setup-local.ps1
# Arranca con:    .\mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# El fichero resultante (application-local.properties) esta en .gitignore:
# es el unico que contiene valores reales y nunca debe subirse.
#
# Solo hace falta declarar aqui lo que sobreescribe a application.properties,
# es decir los secretos. Todo lo demas se hereda del fichero base.
#
# En produccion este fichero no existe: Render define las variables de entorno
# (DB_URL, DB_PASS, JWT_SECRET, CLOUDINARY_*, MAIL_*, STRIPE_*, CORS_ALLOWED_ORIGINS).
# ---------------------------------------------------------------------------

# Base de datos local
spring.datasource.url=jdbc:mysql://localhost:3306/cinema
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.show-sql=true

# Cloudinary — https://cloudinary.com/console
cloudinary.cloud-name=YOUR_CLOUD_NAME
cloudinary.api-key=YOUR_API_KEY
cloudinary.api-secret=YOUR_API_SECRET

# Email — con Gmail usa una App Password, nunca la contrasena de la cuenta
app.mail.from=YOUR_EMAIL@example.com
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@example.com
spring.mail.password=YOUR_MAIL_APP_PASSWORD
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com

# JWT — lo genera setup-local.ps1. Minimo 32 bytes o la app no arranca.
jwt.secret=GENERATED_BY_SETUP_SCRIPT

# CORS — origenes del frontend en local (Vite dev y preview)
app.cors.allowed-origins=http://localhost:5173,http://localhost:4173

# Stripe modo test — https://dashboard.stripe.com/test/apikeys
stripe.secret-key=sk_test_YOUR_SECRET_KEY
stripe.publishable-key=pk_test_YOUR_PUBLISHABLE_KEY
stripe.webhook-secret=whsec_YOUR_WEBHOOK_SECRET
